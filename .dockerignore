# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# Conda 预打包环境 (体积巨大，镜像内通过 pip 安装)
envs/

# Git
.git/
.gitignore

# IDE 配置
.vscode/
.idea/
*.swp
*.swo

# Docker 自身文件
Dockerfile*
docker-compose*
.dockerignore

# 打包脚本和部署脚本 (容器内不需要)
pack.sh
deploy.sh
deploy-prod.sh
deploy.ps1
install-service.sh
knowledge-base.service
cleanup_stale.py
test_*.py

# 文档
*.md
DEPLOY.md
MCP_SKILL.md
README.md

# 环境变量 (不打包到镜像)
.env
.env.example
.env.local

# 数据目录 (运行时生成)
data/

# 临时文件
*.log
*.tmp
*.bak
*~

# 模型锁文件
models/.lock/
