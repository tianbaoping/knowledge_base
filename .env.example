# ============================================
# Knowledge Base System - 环境变量配置示例
# 复制此文件为 .env 并修改配置
# ============================================

# ------ 服务配置 ------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=1.0.0

# ------ Qdrant 向量库配置 ------
# 本地模式 (单机运行)
QDRANT_LOCATION=data/qdrant
# 远程模式 (集群部署)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ------ 嵌入模型配置 ------
# 在线模型 (联网自动下载)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# 离线模型 (预下载到本地)
# MODEL_LOCAL_PATH=models/BAAI_bge-small-zh-v1.5

# ------ OCR 配置 ------
# OCR 模型路径 (默认使用预置路径)
# OCR_DET_MODEL_PATH=ocr_service/models/ch_PP-OCRv4_det_infer.onnx
# OCR_REC_MODEL_PATH=ocr_service/models/ch_PP-OCRv4_rec_infer.onnx
# OCR_CLS_MODEL_PATH=ocr_service/models/ch_ppocr_mobile_v2.0_cls_infer.onnx
# OCR 限制
MAX_IMAGE_SIZE=20MB
MAX_PDF_SIZE=50MB
MAX_PDF_PAGES=50

# ------ 文本切片配置 ------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ------ 文件上传配置 ------
MAX_FILE_SIZE=104857600

# ------ MCP 鉴权配置 ------
MCP_API_KEY=kb-mcp-secret-key-2024

# ------ 日志配置 ------
# LOG_LEVEL=INFO
# LOG_FILE=data/logs/app.log
